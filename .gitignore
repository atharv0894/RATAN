# ==========================================
# RATAN - .gitignore
# ==========================================

# -------------------------
# Python
# -------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# -------------------------
# Virtual Environments
# -------------------------
.venv/
venv/
env/

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Local Vector Databases
# -------------------------
chroma_db/
**/chroma_db/

qdrant_storage/
**/qdrant_storage/

# -------------------------
# Uploaded/Test Documents
# -------------------------
test_data/
**/test_data/

# Ignore only the specific file storage volume, not the code folder
/backend/storage/uploads/

uploads/
**/uploads/

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Test Outputs
# -------------------------
manual_test_output.txt
*_test_output.txt
debug_output.txt

# -------------------------
# Testing
# -------------------------
.pytest_cache/
.coverage
htmlcov/

# -------------------------
# Build
# -------------------------
build/
dist/
*.egg-info/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE
# -------------------------
.vscode/
.idea/

# -------------------------
# macOS
# -------------------------
.DS_Store
**/.DS_Store

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.swp
*.swo

# -------------------------
# Type Checkers / Linters
# -------------------------
.mypy_cache/
.ruff_cache/

# -------------------------
# Hugging Face Cache
# -------------------------
.cache/
huggingface/
.cache/models/

# -------------------------
# Local Database Files
# -------------------------
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal*.db
