# RATAN Backend Environment Template

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace (Optional for specific embeddings)
HF_TOKEN=your_huggingface_token_here

# Object Storage (Backblaze B2)
STORAGE_PROVIDER=b2
B2_KEY_ID=your_b2_key_id
B2_KEY_NAME=ratan-backend
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=RATANAI
B2_ENDPOINT_URL=s3.us-east-005.backblazeb2.com

# Vector Database (Qdrant)
VECTOR_DB=qdrant
QDRANT_URL=your_qdrant_cloud_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# Relational Database (TiDB / MySQL)
# Leave blank to fallback to local SQLite for development
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=ratan_db

# Email / Notifications
RESEND_API=your_resend_api_key_here

# Frontend Coordination
FRONTEND_URL=http://localhost:3000

# Authentication (Google OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/personal/auth/google/callback
